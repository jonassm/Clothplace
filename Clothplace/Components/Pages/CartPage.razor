@page "/CartPage"
@using Core;
@rendermode InteractiveServer
@inject Core.CartClass Cart
@inject Blazored.LocalStorage.ILocalStorageService LocStore
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager navManager


<h3>Indkøbskurv</h3>

@if (henter)
{
    <p>Henter din kurv...</p>
}
else if (Cart.cart.Count == 0) {
    <p>Din kurv er tom</p>
}
else //når vi har en kurv at vise
{
    <div class="liste">
        @foreach (Annonce a in Cart.cart)
        {
            <div>
                <div class="annonceNavn">@a.Name</div>
                <div class="annoncePris">@a.Pris kr.</div>
                <div class="annonceInfo">
                    Ved: @a.Lokation · Kategori: @a.Kategori · Stand: @a.Stand
                </div>
                <div class="annonceBeskrivelse">
                    <!-- Tyvstjålet af chatten. Men er basically en javascript funktion (alert brugte vi også da vi lærte JS, det er en popup) hvor den så skriver annonces besrkivelse i den alert. -->
                    <button @onclick='() => JS.InvokeVoidAsync("alert", a.Beskrivelse).AsTask()'> 
                        Vis beskrivelse
                    </button>
                    <img class="annoncePicture" src="@a.ImageURL" alt="@a.Name" />
                </div>
                <button @onclick="() => RemoveFromCart(a)">Fjern</button>
            </div>
        }
    </div>
    
    

    <p>I alt: @Cart.cart.Sum(a => a.Pris) kr.</p>
    //Sum tager, som man måske kan gætte, en sum af integers. Pris er i integer.
    <p>
        <button @onclick="BuyCart">Køb kurven</button>
    </p>
    
    
    <p>
        <button @onclick="ClearCart">Tøm kurv</button>
    </p>
}



@code {
    public bool henter;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedCart = await LocStore.GetItemAsync<List<Annonce>>("cart");
            if (savedCart != null)
                Cart.cart = savedCart;
 //samme kode som i marketplace for at hente en kurv.
            StateHasChanged();
        }
    }

    private async Task RemoveFromCart(Annonce annonce)
    {
        Cart.RemoveItem(annonce); //trykker vi på remove fjerner vi altså den annonce fra cart.
        await LocStore.SetItemAsync("cart", Cart.cart); // og opdatere kurven.
    }
    private async Task ClearCart()
    {
        Cart.cart.Clear(); //clear cart. Clear fjerner alle elemtner fra en liste.
        await LocStore.RemoveItemAsync("cart"); // og opdater med clear
    }

    private async Task BuyAnnonce(Annonce annonce)
    {
        var buyerId = await LocStore.GetItemAsync<int?>("id");
        if (buyerId is null)
            navManager.NavigateTo("/LoginPage");
        
        //forhåbentlig ikke relevant, men skulle man forvirre sig herind uden at logge ind er det et fint tjek.
        //Man kunne også kalde buyerId et int og ikke have ? men så vil siden bare crashe her
        var response = await Http.PatchAsync($"api/Annonce/buy/{annonce.aID}?BuyerId={buyerId.Value}", null);

        if (response.IsSuccessStatusCode)
            await RemoveFromCart(annonce); //skal ikke være clear cart da det her er pr. objekt.
        
        else
            await JS.InvokeVoidAsync("alert", "Fejl ved køb");
        //send fejlbesked istedet for at lave et crash. JS InvokeVoidAsync benytter JavaScript til at sende en alert.
    }

    private async Task BuyCart() //Det vi kalder ved knappen, som så kører BuyAnnonce på hver item.
    {
        foreach (Annonce a in Cart.cart.ToList())
        {
            await BuyAnnonce(a);
        }
    }
    
}