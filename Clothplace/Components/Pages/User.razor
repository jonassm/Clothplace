@page "/User"
@using Core;
@inject HttpClient Http
@rendermode InteractiveServer
@inject NavigationManager nav
@inject IJSRuntime JS
@inject Blazored.LocalStorage.ILocalStorageService LocStore

<PageTitle>User</PageTitle>

<h3>User</h3>

<button type="button" class="btn btn-primary" @onclick="CreateAnnoncer">Opret annonce</button>
<button class="btn btn-secondary" @onclick="Logout">Log ud</button>

@if (getting) //hvis vi bare laver null tjek på annoncer, vil det aldrig blive skrevet.
    //da annoncer objektet dannes med det samme, og altså ikke er null
{
    <p>Henter...</p>
}
else if (current.Count == 0) { //Ingen grund til at skrive henter hvis der bare ikke er noget på siden. Self. low risk dog
    <p>Du har ingen annoncer</p>
}
else
{
    <div class="liste">
        @foreach (var a in current)
        {
            <div class="annonceMain">
                <div class="annonceNavn">@a.Name</div>
                <div class="annoncePris">@a.Pris kr.</div>
                <div class="annonceInfo">
                    Ved: @a.Lokation · Kategori: @a.Kategori · Stand: @a.Stand
                </div>
                <div class="annonceBeskrivelse"> 
                    <button @onclick='() => JS.InvokeVoidAsync("alert", a.Beskrivelse).AsTask()'>
                        Vis beskrivelse
                    </button>
                    <img class="annoncePicture" src="@a.ImageURL" alt="@a.Name" />
                </div>
                <button @onclick="() => DeleteAnnoncer(a)">Slet</button>
            </div>
        } 
    </div>
}

<h4>Solgte annoncer</h4>

@if (getting)
{
    <p>Henter...</p>
}
else if (sold.Count == 0) //brugeren har ikke solgt noget endnu
{
    <p>Du har ikke solgt noget endnu</p>
}
else
{
    @foreach (var s in sold)
    {
        <div>@s.Name solgt for: @s.Pris kr, og er en: @s.Kategori i: @s.Stand stand</div>
    }
}

<h4>Købte annoncer</h4>

@if (getting)
{
    <p>Henter...</p>
}
else if (bought.Count == 0) //brugeren har ikke solgt noget endnu
{
    <p>Du har ikke købt noget endnu.</p>
}
else
{
    @foreach (var a in bought)
    {
        <div>@a.Name købt for for: @a.Pris kr, og er en: @a.Kategori i: @a.Stand stand</div>
    }
}

@code {

    //precons
    private List<Annonce> annoncer = new List<Annonce>();
    private List<Annonce> bought = new List<Annonce>();
    private List<Annonce> current = new List<Annonce>();
    private List<Annonce> sold = new List<Annonce>(); //brugerens egne annoncer som er solgt
    private bool getting = true; //starter i true, ændres til false når vi har hentet det hele.

    private async Task loadAnnonces(int userId) // til at loade annoncer via HTTP til controller.
    {

        annoncer = await Http.GetFromJsonAsync<List<Annonce>>("api/Annonce/get") ?? new List<Annonce>();
        //api/Annonce/get giver kun ikke-solgte, så solgte henter vi for sig.
        sold = await Http.GetFromJsonAsync<List<Annonce>>($"api/Annonce/sold/{userId}") ?? new List<Annonce>();
        bought = await Http.GetFromJsonAsync<List<Annonce>>($"api/Annonce/bought/{userId}") ?? new List<Annonce>();
        getting = false; //nu har vi hentet, så...
        GetUserAnnoncer(userId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        //LocalStorage kræver JS, som først virker efter første render (ikke under prerender).
        if (!firstRender) return;

        //Hent id'et som LoginPage gemte. Ikke logget ind = send til login.
        if (!await LocStore.ContainKeyAsync("id"))
        {
            nav.NavigateTo("/LoginPage");
            return;
        }

        int userId = await LocStore.GetItemAsync<int>("id");
        await loadAnnonces(userId);
        StateHasChanged(); //opdater siden nu hvor data er hentet
    }

    private void GetUserAnnoncer(int userId)
    {
        current = annoncer.Where(a => a.UserId == userId).ToList(); //vis kun brugerens egne annoncer
    }

    private void CreateAnnoncer()
    {
        nav.NavigateTo("/CreateAnnocer");
    }

    private async Task DeleteAnnoncer(Annonce annonce)
    {
        var response = await Http.DeleteAsync($"api/Annonce/delete/{annonce.aID}");

        if (response.IsSuccessStatusCode) //kun fjern fra listen hvis backenden siger ok
        {
            annoncer.Remove(annonce);
            current.Remove(annonce);
        }
    }

    private async Task Logout()
    {
        await LocStore.RemoveItemAsync("id");
        nav.NavigateTo("/LoginPage");
    }
}
